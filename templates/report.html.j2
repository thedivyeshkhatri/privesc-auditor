<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>PrivEsc Auditor Report</title>
<style>
  :root {
    --critical: #7f1d1d;
    --high: #b91c1c;
    --medium: #b45309;
    --low: #4b5563;
    --bg: #0f1115;
    --card-bg: #181b21;
    --text: #e5e7eb;
    --muted: #9ca3af;
    --border: #2a2e37;
  }
  body {
    font-family: -apple-system, "Segoe UI", Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
    margin: 0;
    padding: 2rem;
    line-height: 1.5;
  }
  h1 { margin-bottom: 0.25rem; }
  .meta { color: var(--muted); margin-bottom: 2rem; font-size: 0.9rem; }
  .summary {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .summary-card {
    padding: 1rem 1.5rem;
    border-radius: 8px;
    min-width: 120px;
    text-align: center;
    border: 1px solid var(--border);
  }
  .summary-card .count { font-size: 1.8rem; font-weight: 700; display: block; }
  .summary-card.CRITICAL { background: var(--critical); }
  .summary-card.HIGH { background: var(--high); }
  .summary-card.MEDIUM { background: var(--medium); }
  .summary-card.LOW { background: var(--low); }

  .finding {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-left: 5px solid var(--muted);
    border-radius: 6px;
    padding: 1rem 1.25rem;
    margin-bottom: 1rem;
  }
  .finding.CRITICAL { border-left-color: #ef4444; }
  .finding.HIGH { border-left-color: #f97316; }
  .finding.MEDIUM { border-left-color: #eab308; }
  .finding.LOW { border-left-color: #6b7280; }

  .finding-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .badge {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    text-transform: uppercase;
  }
  .badge.CRITICAL { background: var(--critical); }
  .badge.HIGH { background: var(--high); }
  .badge.MEDIUM { background: var(--medium); }
  .badge.LOW { background: var(--low); }

  .finding-title { font-weight: 600; font-size: 1.05rem; }
  .field-label { color: var(--muted); font-size: 0.8rem; text-transform: uppercase; margin-top: 0.75rem; }
  pre {
    background: #0b0d11;
    padding: 0.75rem;
    border-radius: 4px;
    overflow-x: auto;
    font-size: 0.85rem;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .no-findings { color: var(--muted); font-style: italic; }
</style>
</head>
<body>

<h1>Local Privilege Escalation Audit Report</h1>
<div class="meta">Generated: {{ generated_at }} &middot; Total findings: {{ total }}</div>

<div class="summary">
  {% for sev in ["CRITICAL", "HIGH", "MEDIUM", "LOW"] %}
  <div class="summary-card {{ sev }}">
    <span class="count">{{ counts[sev] }}</span>
    <span>{{ sev }}</span>
  </div>
  {% endfor %}
</div>

{% if not findings %}
  <p class="no-findings">No findings reported.</p>
{% endif %}

{% for f in findings %}
<div class="finding {{ f.severity.value }}">
  <div class="finding-header">
    <span class="finding-title">{{ f.id }} &mdash; {{ f.title }}</span>
    <span class="badge {{ f.severity.value }}">{{ f.severity.value }}</span>
  </div>

  <div class="field-label">Category</div>
  <div>{{ f.category }}</div>

  <div class="field-label">Affected Path</div>
  <div>{{ f.affected_path }}</div>

  <div class="field-label">Impact</div>
  <div>{{ f.impact }}</div>

  <div class="field-label">Remediation</div>
  <div>{{ f.remediation }}</div>

  {% if f.references %}
  <div class="field-label">References</div>
  <div>
    {% for ref in f.references %}
      <a href="{{ ref }}" style="color:#93c5fd;">{{ ref }}</a><br>
    {% endfor %}
  </div>
  {% endif %}

  <div class="field-label">Evidence</div>
  <pre>{{ f.evidence }}</pre>
</div>
{% endfor %}

</body>
</html>
